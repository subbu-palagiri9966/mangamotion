# Copy to .env. Keys never belong in frontend code or GitHub.
GEMINI_API_KEY=
# Set to a Gemini model that supports image input and structured output.
GEMINI_MODEL=gemini-3.8-flash
RUNWAYML_API_SECRET=
ENABLE_PAID_GENERATION=false
PORT=4173
# Optional absolute executable path if ffmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
